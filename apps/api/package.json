{
  "name": "@med-cod/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:app:generate": "prisma generate --schema=prisma/app/schema.prisma",
    "prisma:reference:generate": "prisma generate --schema=prisma/reference/schema.prisma",
    "prisma:app:migrate": "prisma migrate dev --schema=prisma/app/schema.prisma",
    "prisma:reference:migrate": "prisma migrate dev --schema=prisma/reference/schema.prisma"
  },
  "dependencies": {
    "@med-cod/shared": "*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "prisma": "^5.19.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
